# Copy to .env and fill in. Never commit your real .env.

# --- Roster source ---
# Where your roster comes from: espn (default) | sleeper | manual.
# Override per command with --source / --league / --team.
FF_ROSTER_SOURCE=espn

# --- Multiple leagues (optional) ---
# Follow more than one league from one setup. Each entry is
#   name=source:league_id:team_id[:scoring]
# comma-separated. Pick one on any command with --league-name <name>; the weekly
# Action publishes them all with `publish --all-leagues`. ESPN cookies below are
# per-account, so one pair (ESPN_S2/ESPN_SWID) covers every ESPN league here.
# Example:
# FF_LEAGUES=work=espn:111111:3,dynasty=espn:222222:7:half
FF_LEAGUES=
# Which league is used when you don't pass --league-name (default: the first).
FF_DEFAULT_LEAGUE=
# Local-only alternative to FF_LEAGUES: a gitignored JSON file (see
# leagues.example.json). FF_LEAGUES wins if both are set.
# FF_LEAGUES_FILE=leagues.json

# --- ESPN (default roster source) ---
# League id is in your league URL (.../leagues/<ID>).
ESPN_LEAGUE_ID=
# PUBLIC leagues: set your team id (.../teams/<ID>) so the app knows which is yours.
ESPN_TEAM_ID=
# PRIVATE leagues: paste the two cookies from your logged-in browser
# (DevTools > Application > Cookies). With SWID, the app auto-detects your team.
ESPN_S2=
ESPN_SWID=

# --- Manual roster (when FF_ROSTER_SOURCE=manual or --source manual) ---
# Path to a hand-edited CSV with headers: name,team,position
FF_MANUAL_ROSTER=manual_roster.csv

# --- Sleeper (alternate roster source) ---
# Your Sleeper username. The app resolves this to your user id.
SLEEPER_USERNAME=your_sleeper_username
# Optional: pin a specific league. If unset, the app lists your leagues and
# uses the first NFL league for the current season.
SLEEPER_LEAGUE_ID=

# --- Vegas (The Odds API) ---
# Free tier key from https://the-odds-api.com/  (~500 requests/month).
# If unset, the app still runs on ECR alone and marks Vegas as unavailable.
ODDS_API_KEY=

# --- FantasyPros ECR ---
# Optional API key. If unset (or if the API call fails), the app falls back to
# scraping the public weekly rankings page.
FANTASYPROS_API_KEY=

# --- Preferred journalists (optional, display-only) ---
# Adds a "Preferred journalists" section to the report/dashboard: each listed
# FantasyPros expert's weekly rank per player, plus their average. This is a
# side-by-side view only — it never enters the blend weights or calibration.
# These ranks also annotate every add in the Tuesday waiver report, so this is
# worth setting even if you never read the journalists section itself.
# Format: comma-separated id:Name pairs, where id is the FantasyPros expert id.
#
# To find the ids, just run:
#   ffstartsit experts "Justin Boone" "Jamey Eisenberg" "Dave Richard"
# and paste the line it prints. Then check them with `ffstartsit experts --verify`.
#
# By hand instead: open https://www.fantasypros.com/nfl/rankings/ppr-rb.php,
# click "Pick Experts", select ONLY ONE journalist at a time, apply, and read the
# number from the "filters=" part of the resulting URL. One at a time is what
# makes it unambiguous which id belongs to whom — and a wrong-but-valid id
# silently labels another analyst's ranks with your journalist's name.
# Example (replace the ids with the real ones from that URL):
#   FF_PREFERRED_EXPERTS=1234:Justin Boone,120:Jamey Eisenberg,125:Dave Richard
# Unset/empty/0 hides the section. `ffstartsit experts --verify` catches a dead
# id, a filter FantasyPros ignored, and an id that is silently serving plain
# consensus under your journalist's name.
FF_PREFERRED_EXPERTS=

# --- Tuning (all optional; sensible defaults baked in) ---
# Scoring format: ppr | half | std
FF_SCORING=ppr
# Blend weights (named for the signals).
# Defaults: ecr=0.60, vegas=0.18, injury=0.12, weather=0.10.
# Negative or all-zero weights are rejected and the defaults are used instead.
FF_WEIGHT_ECR=0.60
FF_WEIGHT_VEGAS=0.18
FF_WEIGHT_INJURY=0.12
FF_WEIGHT_WEATHER=0.10
# Final scores within this 0-100 gap are flagged "too close to call".
FF_CLOSE_CALL_THRESHOLD=5.0
# A close call is also flagged when a signal disagrees with the blend about the
# top two. This is the minimum share of total blend weight that signal must
# carry for its disagreement to count, so a lightly-weighted signal can't flag
# every comparison. Raise it for fewer flags, set 0 to flag on any disagreement.
FF_MIN_DISAGREE_WEIGHT=0.15
# How long (seconds) a cached roster is reused before being re-fetched. Rosters
# change weekly on waivers/trades. 0 disables expiry; `--refresh` forces a fetch
# and `--offline` refuses to fetch at all.
FF_ROSTER_TTL=43200
# Injury signal uses the free public Sleeper player data (no key). Set to 0/false
# to turn it off and blend on the other signals alone.
FF_INJURY=1
# Weather signal (no key): free Open-Meteo forecasts nudge outdoor games with high
# wind/rain down; dome & retractable-roof games score neutral. Conditions are read
# at the actual venue and kickoff hour, which come from the free ESPN schedule
# endpoint — if that can't be reached the signal marks itself unavailable and the
# other signals re-weight, rather than guessing. Set to 0/false to disable it.
FF_WEATHER=1
# Before Week 1 there is no live ECR/Vegas data, so runs are filled with bundled
# SAMPLE data (clearly labeled with a preseason warning). Set to 0/false to show
# the warning with empty slots instead.
FF_PRESEASON_FILL=1

# --- Waiver wire & trades (the Tuesday-evening pass) ---
# `ffstartsit waivers` reads your league's free-agent pool and every other
# team's roster, then suggests adds (paired with a drop), FAAB bids or waiver
# claims, stashes, upcoming bye holes, and concrete trade offers. It works for
# ESPN and Sleeper leagues; a `manual` CSV league is skipped, since a hand-typed
# roster has no league behind it.
#
# None of these are blend weights — the waiver pass adds no signal and changes
# no start/sit ranking. Waiver runs are also never written to the results log,
# so they can't skew `calibrate` (#7).
#
# The adds are scored against your roster using the same ensemble as start/sit,
# and annotated with your FF_PREFERRED_EXPERTS journalists' ranks — set those
# above to get Boone/Eisenberg/Richard into this report.
#
# How many free agents to consider per league, in the platform's own relevance
# order (ESPN percent-owned, Sleeper search_rank). Higher = slower, not better.
FF_WAIVER_LIMIT=150
# Most adds (and drop candidates) listed per league.
FF_WAIVER_MAX_ADDS=8
# Trade ideas: set FF_TRADE_SUGGESTIONS=0 to drop the section entirely.
FF_TRADE_SUGGESTIONS=1
FF_MAX_TRADE_IDEAS=5
# Also quote the three writers' weekly waiver columns (CBS for Jamey Eisenberg
# and Dave Richard, Yahoo for Justin Boone). Purely decorative: names found in a
# column are matched against your free-agent pool and shown as a quote. If a
# site changes layout or paywalls the piece, the quotes vanish and the report is
# otherwise unchanged. Set to 0 to skip the fetch entirely.
FF_COLUMN_SCRAPE=1

# --- Distribution (optional) ---
# Discord incoming webhook (Server Settings > Integrations > Webhooks). If set,
# `ffstartsit notify` (and the weekly Action) push the lineup + alerts to it.
DISCORD_WEBHOOK_URL=
# Public dashboard URL the notification links to. In the scheduled Actions this
# is filled automatically from the GitHub Pages deploy; set it for local
# `notify`. The site has two pages: index.html (start/sit) and waivers.html.
FF_DASHBOARD_URL=
# Repo web URL (https://github.com/<owner>/<repo>). Used by the Discord embed to
# link to the GitHub issues where the / commands work. In the weekly Action this
# is derived automatically from GITHUB_REPOSITORY; set it for local `notify`.
FF_REPO_URL=
